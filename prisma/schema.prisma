generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
} 

datasource db {
  provider = "postgresql"
}

model Order {
  id        String   @id @default(uuid())
  orderID   String   @unique
  createdAt DateTime @default(now())
}
model Student {
  id        Int    @id @default(autoincrement())
  studentId String @unique
  name      String
  age       Int
}